#!/bin/bash -l
#PBS -q {{ queue }}
#PBS -l select=1
#PBS -l walltime={{ walltime }}
#PBS -P {{ group }}
#PBS -N {{ job_name }}
#PBS -o {{ output_path }}
{% if join_output %}#PBS -j oe
{% endif %}
set -euo pipefail

cd {{ workdir }}
{% for setup_command in setup_commands %}
{{ setup_command }}
{% endfor %}
{% if monitor_enabled %}
set -m
(
  trap 'exit 0' INT TERM
  while true; do
{% for monitor_command in monitor_commands %}
    {{ monitor_command }}
{% endfor %}
    sleep {{ monitor_interval }}
  done
) &
monitor_pid=$!
set +m
cleanup_monitor() {
  kill -TERM -- "-$monitor_pid" 2>/dev/null || true
  wait "$monitor_pid" 2>/dev/null || true
}
exit_on_signal() {
  local exit_status=$1
  trap - EXIT INT TERM
  cleanup_monitor
  exit "$exit_status"
}
trap cleanup_monitor EXIT
trap 'exit_on_signal 130' INT
trap 'exit_on_signal 143' TERM
{% endif %}
{{ command }}
